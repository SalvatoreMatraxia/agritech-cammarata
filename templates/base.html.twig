<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=no">
    <title>{% block title %}Agritech Cammarata{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%232D5016'><path d='M17 8C8 10 5.9 16.17 3.82 21c1.5.04 3.06-.84 4.18-2 2.16 2.47 5.09 2.95 7 0 3-4.5 2.5-11 2-13z'/></svg>">
    {% block stylesheets %}{% endblock %}
    {% block importmap %}{{ importmap('app') }}{% endblock %}
</head>
<body>

{% if app.user %}
<aside class="app-sidebar" id="app-sidebar">

    <a class="app-sidebar-logo" href="{{ path('dashboard_index') }}">
        {{ icon('leaf', 'icon') }} Agritech Cammarata
    </a>

    <nav class="app-sidebar-nav">
        <a class="app-sidebar-link {% if app.request.attributes.get('_route') starts with 'dashboard' %}active{% endif %}"
           href="{{ path('dashboard_index') }}">
            {{ icon('layout-dashboard', 'icon') }}<span>Dashboard</span>
        </a>
        <a class="app-sidebar-link {% if app.request.attributes.get('_route') starts with 'monitoring' %}active{% endif %}"
           href="{{ path('monitoring_index') }}">
            {{ icon('activity', 'icon') }}<span>Monitoring</span>
        </a>
        <a class="app-sidebar-link {% if app.request.attributes.get('_route') starts with 'treatment' %}active{% endif %}"
           href="{{ path('treatment_index') }}">
            {{ icon('clipboard-list', 'icon') }}<span>Quaderno</span>
        </a>
        <a class="app-sidebar-link {% if app.request.attributes.get('_route') starts with 'operation' %}active{% endif %}"
           href="{{ path('operation_index') }}">
            {{ icon('wrench', 'icon') }}<span>Operazioni</span>
        </a>
        <a class="app-sidebar-link {% if app.request.attributes.get('_route') starts with 'map' %}active{% endif %}"
           href="{{ path('map_index') }}">
            {{ icon('map', 'icon') }}<span>Mappa</span>
        </a>
        <a class="app-sidebar-link {% if app.request.attributes.get('_route') starts with 'farm_memory' %}active{% endif %}"
           href="{{ path('farm_memory_index') }}">
            {{ icon('history', 'icon') }}<span>Storico</span>
        </a>
    </nav>

    <div class="app-sidebar-user">
        <div class="app-sidebar-user-email">
            {{ icon('user', 'icon') }}<span>{{ app.user.email }}</span>
        </div>
        <a class="app-sidebar-logout" href="{{ path('app_logout') }}">
            {{ icon('log-out', 'icon') }}<span>Esci</span>
        </a>
    </div>

</aside>

<div class="sidebar-overlay" id="sidebar-overlay"></div>

<header class="mobile-header">
    <button class="sidebar-hamburger" id="sidebar-hamburger" aria-label="Apri menu" aria-expanded="false">
        {{ icon('menu', 'icon') }}
    </button>
    <span class="mobile-header-brand">Agritech Cammarata</span>
</header>
{% endif %}

<div class="app-body{% if not app.user %} no-sidebar{% endif %}">
    {% block main %}
    <main class="main-content">
        {% for msg in app.flashes('success') %}<div class="flash flash-success">{{ msg }}</div>{% endfor %}
        {% for msg in app.flashes('warning') %}<div class="flash flash-warning">{{ msg }}</div>{% endfor %}
        {% for msg in app.flashes('error')   %}<div class="flash flash-error">{{ msg }}</div>{% endfor %}

        {% block body %}{% endblock %}
    </main>
    {% endblock %}
</div>

{% block javascripts %}{% endblock %}
</body>
</html>