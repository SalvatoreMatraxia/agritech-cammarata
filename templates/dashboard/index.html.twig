{% extends 'base.html.twig' %}

{% block title %}Dashboard — Agritech Cammarata{% endblock %}

{% block body %}
<div class="page-title">
    Benvenuto{% if farm %}, <strong>{{ farm.name }}</strong>{% endif %}
    <small>{{ 'now'|date('d/m/Y') }}</small>
</div>

{% if farm is null %}
    <div class="empty-state">
        <span class="emoji">🌿</span>
        Nessuna azienda configurata. Contatta l'amministratore.
    </div>
{% else %}

<div class="dashboard-grid">

    {# ── METEO OGGI ─────────────────────────────────────── #}
    <div class="card">
        <div class="card-header">
            <span class="icon">🌤️</span>
            Meteo Oggi — {{ farm.municipality }} ({{ farm.altitude }} m)
        </div>
        <div class="card-body">
            {% if weather %}
            <div class="stat-grid">
                <div class="stat-box">
                    <div class="stat-icon">🌡️</div>
                    <div class="stat-value">{{ weather.temp is not null ? weather.temp|number_format(1) ~ '°' : '—' }}</div>
                    <div class="stat-label">Temperatura</div>
                </div>
                <div class="stat-box">
                    <div class="stat-icon">💧</div>
                    <div class="stat-value">{{ weather.humidity is not null ? weather.humidity ~ '%' : '—' }}</div>
                    <div class="stat-label">Umidità</div>
                </div>
                <div class="stat-box">
                    <div class="stat-icon">🌧️</div>
                    <div class="stat-value">{{ weather.rain is not null ? weather.rain|number_format(1) ~ ' mm' : '—' }}</div>
                    <div class="stat-label">Pioggia</div>
                </div>
                <div class="stat-box">
                    <div class="stat-icon">💨</div>
                    <div class="stat-value">{{ weather.wind is not null ? weather.wind|number_format(0) ~ ' km/h' : '—' }}</div>
                    <div class="stat-label">Vento</div>
                </div>
            </div>
            {% if weather.time %}
            <p class="weather-timestamp">Rilevazione: {{ weather.time|replace({'T': ' '}) }}</p>
            {% endif %}
            {% else %}
            <p class="no-data">Dati meteo non disponibili.</p>
            {% endif %}
        </div>
    </div>

    {# ── LA TUA AZIENDA ──────────────────────────────────── #}
    <div class="card">
        <div class="card-header">
            <span class="icon">🌿</span>
            La Tua Azienda
        </div>
        <div class="card-body">
            <div class="info-list">
                <div class="info-row">
                    <span class="label">Nome azienda</span>
                    <span class="value">{{ farm.name }}</span>
                </div>
                <div class="info-row">
                    <span class="label">Superficie totale</span>
                    <span class="value">{{ farm.surface|number_format(1) }} ha</span>
                </div>
                <div class="info-row">
                    <span class="label">Piante totali</span>
                    <span class="value">{{ totalTrees }}</span>
                </div>
                <div class="info-row">
                    <span class="label">Comune</span>
                    <span class="value">{{ farm.municipality }}</span>
                </div>
                <div class="info-row">
                    <span class="label">Altitudine</span>
                    <span class="value">{{ farm.altitude }} m s.l.m.</span>
                </div>
                <div class="info-row">
                    <span class="label">Tipo suolo</span>
                    <span class="value">{{ farm.soilType|replace({'_': ' '})|capitalize }}</span>
                </div>
                <div class="info-row">
                    <span class="label">Parcelle</span>
                    <span class="value">{{ farm.parcels|length }}</span>
                </div>
            </div>
        </div>
    </div>

    {# ── PREVISIONI 7 GIORNI ─────────────────────────────── #}
    {% if forecast|length > 0 %}
    <div class="card span-2">
        <div class="card-header">
            <span class="icon">📅</span>
            Previsioni 7 Giorni
        </div>
        <div class="card-body">
            <div class="chart-wrap">
                <canvas id="forecast-chart"
                    data-labels="{{ forecast|map(d => d.date|date('d/m'))|json_encode }}"
                    data-tmax="{{ forecast|map(d => d.temp_max)|json_encode }}"
                    data-tmin="{{ forecast|map(d => d.temp_min)|json_encode }}"
                    data-rain="{{ forecast|map(d => d.rain)|json_encode }}">
                </canvas>
            </div>
            <div class="forecast-row forecast-header">
                <span>Data</span>
                <span class="val">Max °C</span>
                <span class="val">Min °C</span>
                <span class="val">Pioggia</span>
                <span class="val">ET₀</span>
            </div>
            {% for day in forecast %}
            <div class="forecast-row">
                <span class="date">{{ day.date|date('d/m') }}</span>
                <span class="val val-hot">{{ day.temp_max is not null ? day.temp_max|number_format(1) ~ '°' : '—' }}</span>
                <span class="val val-cold">{{ day.temp_min is not null ? day.temp_min|number_format(1) ~ '°' : '—' }}</span>
                <span class="val">{{ day.rain is not null ? day.rain|number_format(1) ~ ' mm' : '—' }}</span>
                <span class="val val-green">{{ day.et0 is not null ? day.et0|number_format(1) ~ ' mm' : '—' }}</span>
            </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    {# ── PARCELLE ─────────────────────────────────────────── #}
    {% if farm.parcels|length > 0 %}
    <div class="card span-2">
        <div class="card-header">
            <span class="icon">🗺️</span>
            Parcelle
        </div>
        <div class="card-body">
            <div class="parcels-grid">
                {% for parcel in farm.parcels %}
                <div class="parcel-card">
                    <div class="parcel-name">{{ parcel.name }}</div>
                    <div class="parcel-details">
                        <span>🫒 {{ parcel.variety }}</span>
                        <span>📐 {{ parcel.surface|number_format(1) }} ha · {{ parcel.treeCount }} piante</span>
                        <span>🧭 Esp. {{ parcel.aspect ?? '—' }} · {{ parcel.altitude ?? '—' }} m</span>
                        <span>🌿 {% if parcel.isBiological %}Biologico{% else %}Convenzionale{% endif %}</span>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
    {% endif %}

</div>
{% endif %}
{% endblock %}