{% extends 'base.html.twig' %}

{% block title %}Dashboard — Agritech Cammarata{% endblock %}

{% block body %}
<div class="page-title">
    Benvenuto{% if farm %}, <strong>{{ farm.name }}</strong>{% endif %}
    <small>{{ 'now'|date('d/m/Y') }}</small>
</div>

{% if farm is null %}
    <div class="empty-state">
        <span class="emoji">🌿</span>
        Nessuna azienda configurata. Contatta l'amministratore.
    </div>
{% else %}

<div class="dashboard-grid">

    {# ── METEO OGGI ─────────────────────────────────────── #}
    <div class="card">
        <div class="card-header">
            <span class="icon">🌤️</span>
            Meteo Oggi — {{ farm.municipality }} ({{ farm.altitude }} m)
        </div>
        <div class="card-body">
            {% if weather %}
            <div class="stat-grid">
                <div class="stat-box">
                    <div class="stat-icon">🌡️</div>
                    <div class="stat-value">{{ weather.temp is not null ? weather.temp|number_format(1) ~ '°' : '—' }}</div>
                    <div class="stat-label">Temperatura</div>
                </div>
                <div class="stat-box">
                    <div class="stat-icon">💧</div>
                    <div class="stat-value">{{ weather.humidity is not null ? weather.humidity ~ '%' : '—' }}</div>
                    <div class="stat-label">Umidità</div>
                </div>
                <div class="stat-box">
                    <div class="stat-icon">🌧️</div>
                    <div class="stat-value">{{ weather.rain is not null ? weather.rain|number_format(1) ~ ' mm' : '—' }}</div>
                    <div class="stat-label">Pioggia</div>
                </div>
                <div class="stat-box">
                    <div class="stat-icon">💨</div>
                    <div class="stat-value">{{ weather.wind is not null ? weather.wind|number_format(0) ~ ' km/h' : '—' }}</div>
                    <div class="stat-label">Vento</div>
                </div>
            </div>
            {% if weather.time %}
            <p class="weather-timestamp">Rilevazione: {{ weather.time|replace({'T': ' '}) }}</p>
            {% endif %}
            {% else %}
            <p class="no-data">Dati meteo non disponibili.</p>
            {% endif %}
        </div>
    </div>

    {# ── LA TUA AZIENDA ──────────────────────────────────── #}
    <div class="card">
        <div class="card-header">
            <span class="icon">🌿</span>
            La Tua Azienda
        </div>
        <div class="card-body">
            <div class="info-list">
                <div class="info-row">
                    <span class="label">Nome azienda</span>
                    <span class="value">{{ farm.name }}</span>
                </div>
                <div class="info-row">
                    <span class="label">Superficie totale</span>
                    <span class="value">{{ farm.surface|number_format(1) }} ha</span>
                </div>
                <div class="info-row">
                    <span class="label">Piante totali</span>
                    <span class="value">{{ totalTrees }}</span>
                </div>
                <div class="info-row">
                    <span class="label">Comune</span>
                    <span class="value">{{ farm.municipality }}</span>
                </div>
                <div class="info-row">
                    <span class="label">Altitudine</span>
                    <span class="value">{{ farm.altitude }} m s.l.m.</span>
                </div>
                <div class="info-row">
                    <span class="label">Tipo suolo</span>
                    <span class="value">{{ farm.soilType|replace({'_': ' '})|capitalize }}</span>
                </div>
                <div class="info-row">
                    <span class="label">Parcelle</span>
                    <span class="value">{{ farm.parcels|length }}</span>
                </div>
            </div>
        </div>
    </div>

    {# ── PREVISIONI 7 GIORNI ─────────────────────────────── #}
    {% if forecast|length > 0 %}
    <div class="card span-2">
        <div class="card-header">
            <span class="icon">📅</span>
            Previsioni 7 Giorni
        </div>
        <div class="card-body">
            <div class="chart-wrap">
                <canvas id="forecast-chart"
                    data-chart="weather"
                    data-labels="{{ forecast|map(d => d.date|date('d/m'))|json_encode }}"
                    data-tmax="{{ forecast|map(d => d.temp_max)|json_encode }}"
                    data-tmin="{{ forecast|map(d => d.temp_min)|json_encode }}"
                    data-rain="{{ forecast|map(d => d.rain)|json_encode }}">
                </canvas>
            </div>
            <div class="forecast-row forecast-header">
                <span>Data</span>
                <span class="val">Max °C</span>
                <span class="val">Min °C</span>
                <span class="val">Pioggia</span>
                <span class="val">ET₀</span>
            </div>
            {% for day in forecast %}
            <div class="forecast-row">
                <span class="date">{{ day.date|date('d/m') }}</span>
                <span class="val val-hot">{{ day.temp_max is not null ? day.temp_max|number_format(1) ~ '°' : '—' }}</span>
                <span class="val val-cold">{{ day.temp_min is not null ? day.temp_min|number_format(1) ~ '°' : '—' }}</span>
                <span class="val">{{ day.rain is not null ? day.rain|number_format(1) ~ ' mm' : '—' }}</span>
                <span class="val val-green">{{ day.et0 is not null ? day.et0|number_format(1) ~ ' mm' : '—' }}</span>
            </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    {# ── STATO VEGETAZIONE NDVI ──────────────────────────── #}
    <div class="card">
        <div class="card-header">
            <span class="icon">🛰️</span>
            Stato Vegetazione — NDVI Satellite
        </div>
        {% if ndvi %}
        {% set nv = ndvi.ndvi_current %}
        {% set ndviClass = nv < 0.25 ? 'ndvi-val-red' : (nv < 0.35 ? 'ndvi-val-orange' : (nv < 0.45 ? 'ndvi-val-yellow' : (nv < 0.55 ? 'ndvi-val-light-green' : 'ndvi-val-dark-green'))) %}
        <div class="card-body">
            {% if ndvi.anomaly %}
            <div class="ndvi-anomaly-badge">⚠️ {{ ndvi.anomaly_description }}</div>
            {% endif %}
            <div class="ndvi-big {{ ndviClass }}">{{ nv|number_format(3) }}</div>
            <div class="ndvi-trend-row">
                {% if ndvi.ndvi_trend == 'improving' %}
                <span class="trend-up">↑ In miglioramento</span>
                {% elseif ndvi.ndvi_trend == 'declining' %}
                <span class="trend-down">↓ In calo</span>
                {% else %}
                <span class="trend-stable">→ Stabile</span>
                {% endif %}
                <span class="ndvi-source">{{ ndvi.source == 'agromonitoring' ? 'Satellite' : 'Stimato ET₀' }}</span>
            </div>
            {% if ndvi.ndvi_history|length > 0 %}
            <div class="sparkline-wrapper">
                <canvas class="ndvi-sparkline ndvi-sparkline-dash"
                    data-chart="ndvi"
                    data-history="{{ ndvi.ndvi_history|map(h => h.ndvi)|slice(-30)|json_encode }}"
                    data-labels="{{ ndvi.ndvi_history|map(h => h.date)|slice(-30)|json_encode }}"></canvas>
            </div>
            {% endif %}
            <div class="ndvi-range">
                Min 90gg: <strong>{{ ndvi.ndvi_min_90d|number_format(3) }}</strong> ·
                Max: <strong>{{ ndvi.ndvi_max_90d|number_format(3) }}</strong>
            </div>
        </div>
        {% else %}
        <div class="card-body">
            <p class="prediction-empty">NDVI non disponibile — avvia il microservizio AI.</p>
        </div>
        {% endif %}
        <div class="card-footer">
            <a href="{{ path('map_index') }}" class="update-btn">Vedi Mappa Completa</a>
        </div>
    </div>

    {# ── PREVISIONE RESA ──────────────────────────────────── #}
    <div class="card">
        <div class="card-header">
            <span class="icon">🫒</span>
            Previsione Resa {{ 'now'|date('Y') }}
        </div>
        {% if yieldPrediction %}
        {% set yr = yieldPrediction.result %}
        <div class="card-body">
            <div class="stat-grid">
                <div class="stat-box">
                    <div class="stat-icon">⚖️</div>
                    <div class="stat-value">{{ yr.yield_kg_ha|number_format(0) }}</div>
                    <div class="stat-label">kg/ha</div>
                </div>
                <div class="stat-box">
                    <div class="stat-icon">🫙</div>
                    <div class="stat-value">{{ yr.oil_liters|number_format(0) }}</div>
                    <div class="stat-label">Litri olio</div>
                </div>
            </div>
            {% if yr.scenarios is defined %}
            <div class="scenarios-grid">
                <div class="scenario-box">
                    <div class="scenario-label">Pessimistico</div>
                    <div class="scenario-value">{{ yr.scenarios.pessimistico.yield_kg_ha|number_format(0) }}</div>
                    <div class="scenario-sub">kg/ha</div>
                </div>
                <div class="scenario-box">
                    <div class="scenario-label">Medio</div>
                    <div class="scenario-value">{{ yr.scenarios.medio.yield_kg_ha|number_format(0) }}</div>
                    <div class="scenario-sub">kg/ha</div>
                </div>
                <div class="scenario-box">
                    <div class="scenario-label">Ottimistico</div>
                    <div class="scenario-value">{{ yr.scenarios.ottimistico.yield_kg_ha|number_format(0) }}</div>
                    <div class="scenario-sub">kg/ha</div>
                </div>
            </div>
            {% endif %}
            {% if yieldPrediction.explanationText %}
            <div class="explanation-box">{{ yieldPrediction.explanationText }}</div>
            {% endif %}
            <p class="prediction-meta">
                Metodo: {{ yr.method ?? yieldPrediction.method }} ·
                Confidenza: {{ (yieldPrediction.confidence * 100)|number_format(0) }}% ·
                {{ yieldPrediction.createdAt|date('d/m/Y H:i') }}
            </p>
        </div>
        {% else %}
        <div class="card-body">
            <p class="prediction-empty">Nessuna previsione — clicca Aggiorna per calcolarla.</p>
        </div>
        {% endif %}
        <div class="card-footer">
            <form method="post" action="{{ path('dashboard_predict_yield') }}">
                <button type="submit" class="update-btn">Aggiorna Previsione</button>
            </form>
        </div>
    </div>

    {# ── RISCHIO MOSCA OLEARIA ────────────────────────────── #}
    <div class="card">
        <div class="card-header">
            <span class="icon">🪰</span>
            Rischio Mosca Olearia
        </div>
        {% if pestPrediction %}
        {% set pr = pestPrediction.result %}
        {% set riskClass = pr.risk_score < 0.3 ? 'risk-low' : (pr.risk_score < 0.5 ? 'risk-medium' : (pr.risk_score < 0.7 ? 'risk-high' : 'risk-very-high')) %}
        <div class="card-body">
            <div class="risk-badge {{ riskClass }}">
                <span class="risk-score-value">{{ (pr.risk_score * 100)|number_format(0) }}%</span>
                Rischio {{ pr.risk_level|capitalize }}
            </div>
            <div class="info-list" style="margin-top: 0.75rem;">
                <div class="info-row">
                    <span class="label">Generazione</span>
                    <span class="value">Gen. {{ pr.generazione_n ?? '—' }}</span>
                </div>
                <div class="info-row">
                    <span class="label">Fase biologica</span>
                    <span class="value">{{ pr.fase_corrente is defined ? pr.fase_corrente|capitalize : '—' }}</span>
                </div>
                {% if pr.finestra_trattamento is defined %}
                <div class="info-row">
                    <span class="label">Finestra trattamento</span>
                    <span class="value">{{ pr.finestra_trattamento.inizio }} / {{ pr.finestra_trattamento.fine }}</span>
                </div>
                {% endif %}
                {% if pr.economic_impact is defined %}
                <div class="info-row">
                    <span class="label">Perdita stimata</span>
                    <span class="value">{{ pr.economic_impact.perdita_stimata_eur_ha|number_format(0) }} €/ha</span>
                </div>
                {% endif %}
            </div>
            {% if pr.recommendations is defined and pr.recommendations|length > 0 %}
            <ul class="recommendation-list">
                {% for rec in pr.recommendations %}
                <li>{{ rec }}</li>
                {% endfor %}
            </ul>
            {% endif %}
            {% if pestPrediction.explanationText %}
            <div class="explanation-box">{{ pestPrediction.explanationText }}</div>
            {% endif %}
            <p class="prediction-meta">{{ pestPrediction.createdAt|date('d/m/Y H:i') }}</p>
        </div>
        {% else %}
        <div class="card-body">
            <p class="prediction-empty">Nessuna analisi — clicca Aggiorna per calcolarla.</p>
        </div>
        {% endif %}
        <div class="card-footer">
            <form method="post" action="{{ path('dashboard_predict_pest') }}">
                <button type="submit" class="update-btn">Aggiorna</button>
            </form>
        </div>
    </div>

    {# ── STRESS IDRICO ────────────────────────────────────── #}
    <div class="card">
        <div class="card-header">
            <span class="icon">💧</span>
            Stress Idrico — Bilancio FAO-56
        </div>
        {% if waterPrediction %}
        {% set wr = waterPrediction.result %}
        {% set stressPct = (wr.stress_index * 100)|round %}
        {% set stressClass = wr.stress_index == 0 ? 'stress-fill-none' : (wr.stress_index < 0.25 ? 'stress-fill-low' : (wr.stress_index < 0.5 ? 'stress-fill-medium' : (wr.stress_index < 0.75 ? 'stress-fill-high' : 'stress-fill-severe'))) %}
        <div class="card-body">
            <div class="stress-bar-wrap">
                <div class="stress-bar-label">
                    <span>Indice stress</span>
                    <span><strong>{{ stressPct }}%</strong></span>
                </div>
                <div class="stress-bar">
                    <div class="stress-bar-fill {{ stressClass }}" style="width: {{ stressPct > 100 ? 100 : stressPct }}%"></div>
                </div>
            </div>
            <div class="stress-bar-wrap">
                <div class="stress-bar-label">
                    <span>Riserva idrica</span>
                    <span><strong>{{ wr.reserve_pct|number_format(0) }}%</strong></span>
                </div>
                <div class="stress-bar">
                    <div class="reserve-bar-fill" style="width: {{ wr.reserve_pct > 100 ? 100 : wr.reserve_pct }}%"></div>
                </div>
            </div>
            <div class="{{ wr.irrigation_needed ? 'irrigation-alert irrigation-needed' : 'irrigation-alert irrigation-ok' }}">
                {% if wr.irrigation_needed %}
                    Irrigazione necessaria — {{ wr.volume_mc_per_ha|number_format(1) }} m³/ha
                {% else %}
                    Nessuna irrigazione necessaria
                {% endif %}
            </div>
            {% if wr.economic_impact is defined and wr.economic_impact.costo_acqua_eur > 0 %}
            <div class="info-list" style="margin-top: 0.6rem;">
                <div class="info-row">
                    <span class="label">Costo irrigazione</span>
                    <span class="value">{{ wr.economic_impact.costo_acqua_eur|number_format(0) }} €</span>
                </div>
            </div>
            {% endif %}
            {% if waterPrediction.explanationText %}
            <div class="explanation-box">{{ waterPrediction.explanationText }}</div>
            {% endif %}
            <p class="prediction-meta">{{ waterPrediction.createdAt|date('d/m/Y H:i') }}</p>
        </div>
        {% else %}
        <div class="card-body">
            <p class="prediction-empty">Nessun bilancio — clicca Aggiorna per calcolarlo.</p>
        </div>
        {% endif %}
        <div class="card-footer">
            <form method="post" action="{{ path('dashboard_predict_water') }}">
                <button type="submit" class="update-btn">Aggiorna</button>
            </form>
        </div>
    </div>

    {# ── PARCELLE ─────────────────────────────────────────── #}
    {% if farm.parcels|length > 0 %}
    <div class="card span-2">
        <div class="card-header">
            <span class="icon">🗺️</span>
            Parcelle
        </div>
        <div class="card-body">
            <div class="parcels-grid">
                {% for parcel in farm.parcels %}
                <div class="parcel-card">
                    <div class="parcel-name">{{ parcel.name }}</div>
                    <div class="parcel-details">
                        <span>🫒 {{ parcel.variety }}</span>
                        <span>📐 {{ parcel.surface|number_format(1) }} ha · {{ parcel.treeCount }} piante</span>
                        <span>🧭 Esp. {{ parcel.aspect ?? '—' }} · {{ parcel.altitude ?? '—' }} m</span>
                        <span>🌿 {% if parcel.isBiological %}Biologico{% else %}Convenzionale{% endif %}</span>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
    {% endif %}

</div>
{% endif %}
{% endblock %}