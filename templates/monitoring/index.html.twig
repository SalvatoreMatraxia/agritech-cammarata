{% extends 'base.html.twig' %}

{% block title %}Monitoring Oliveto — Agritech Cammarata{% endblock %}

{% block body %}
<div class="page-title">
    {{ icon('activity', 'icon') }} Monitoring Oliveto
    <small>Analisi ML in tempo reale — satellite, resa, fitofagi, bilancio idrico</small>
</div>

{% if farm is null %}
<div class="empty-state">
    <span class="empty-icon">{{ icon('activity', 'icon') }}</span>
    Nessuna azienda configurata. Contatta l'amministratore.
</div>
{% else %}

<div class="dashboard-grid">

    {# ── STATO VEGETAZIONE NDVI ──────────────────────────── #}
    <div class="card">
        <div class="card-header">
            {{ icon('satellite', 'icon') }}
            Stato Vegetazione — NDVI Satellite
        </div>
        {% if ndvi %}
        {% set nv = ndvi.ndvi_current %}
        {% set ndviClass = nv < 0.25 ? 'ndvi-val-red' : (nv < 0.35 ? 'ndvi-val-orange' : (nv < 0.45 ? 'ndvi-val-yellow' : (nv < 0.55 ? 'ndvi-val-light-green' : 'ndvi-val-dark-green'))) %}
        <div class="card-body">
            {% if ndvi.anomaly %}
            <div class="ndvi-anomaly-badge">{{ icon('alert-triangle', 'icon') }} {{ ndvi.anomaly_description }}</div>
            {% endif %}
            <div class="ndvi-big {{ ndviClass }}">{{ nv|number_format(3) }}</div>
            <div class="ndvi-trend-row">
                {% if ndvi.ndvi_trend == 'improving' %}
                <span class="trend-up">↑ In miglioramento</span>
                {% elseif ndvi.ndvi_trend == 'declining' %}
                <span class="trend-down">↓ In calo</span>
                {% else %}
                <span class="trend-stable">→ Stabile</span>
                {% endif %}
                <span class="ndvi-source">{{ ndvi.source == 'agromonitoring' ? 'Satellite' : 'Stimato ET₀' }}</span>
            </div>
            {% if ndvi.ndvi_history|length > 0 %}
            <div class="sparkline-wrapper">
                <canvas class="ndvi-sparkline ndvi-sparkline-dash"
                    data-chart="ndvi"
                    data-history="{{ ndvi.ndvi_history|map(h => h.ndvi)|slice(-30)|json_encode }}"
                    data-labels="{{ ndvi.ndvi_history|map(h => h.date)|slice(-30)|json_encode }}"></canvas>
            </div>
            {% endif %}
            <div class="ndvi-range">
                Min 90gg: <strong>{{ ndvi.ndvi_min_90d|number_format(3) }}</strong> ·
                Max: <strong>{{ ndvi.ndvi_max_90d|number_format(3) }}</strong>
            </div>
        </div>
        {% else %}
        <div class="card-body">
            <p class="prediction-empty">NDVI non disponibile — avvia il microservizio AI.</p>
        </div>
        {% endif %}
        <div class="card-footer">
            <a href="{{ path('map_index') }}" class="update-btn">Vedi Mappa Completa</a>
        </div>
    </div>

    {# ── PREVISIONE RESA ──────────────────────────────────── #}
    <div class="card">
        <div class="card-header">
            {{ icon('leaf', 'icon') }}
            Previsione Resa {{ 'now'|date('Y') }}
        </div>
        {% if yieldPrediction %}
        {% set yr = yieldPrediction.result %}
        {% set oil_per_ha = yr.oil_liters / farm.surface %}
        <div class="card-body">
            <div class="yield-split">
                <div class="yield-col">
                    <div class="yield-col-header">Per Ettaro</div>
                    <div class="yield-row-value">{{ yr.yield_kg_ha|number_format(0, ',', '.') }}</div>
                    <div class="yield-row-label">kg olive / ha</div>
                    <div class="yield-row-value">{{ oil_per_ha|number_format(0, ',', '.') }}</div>
                    <div class="yield-row-label">litri olio / ha</div>
                </div>
                <div class="yield-col">
                    <div class="yield-col-header">
                        Totale Azienda
                        <small>(su {{ farm.surface|number_format(1, ',', '.') }} ha)</small>
                    </div>
                    <div class="yield-row-value">{{ yr.total_kg|number_format(0, ',', '.') }}</div>
                    <div class="yield-row-label">kg olive totali</div>
                    <div class="yield-row-value">{{ yr.oil_liters|number_format(0, ',', '.') }}</div>
                    <div class="yield-row-label">litri olio totali</div>
                </div>
            </div>
            {% if yieldPrediction.explanationText %}
            <div class="explanation-box mt-md">{{ yieldPrediction.explanationText }}</div>
            {% endif %}
            <p class="prediction-meta">
                Metodo: {{ yr.method ?? yieldPrediction.method }} ·
                Confidenza: {{ (yieldPrediction.confidence * 100)|number_format(0) }}% ·
                {{ yieldPrediction.createdAt|date('d/m/Y H:i') }}
            </p>
        </div>
        {% else %}
        <div class="card-body">
            <p class="prediction-empty">Nessuna previsione — clicca Aggiorna per calcolarla.</p>
        </div>
        {% endif %}
        <div class="card-footer">
            <form method="post" action="{{ path('monitoring_predict_yield') }}">
                <button type="submit" class="update-btn">Aggiorna Previsione</button>
            </form>
        </div>
    </div>

    {# ── RISCHIO MOSCA OLEARIA ────────────────────────────── #}
    <div class="card">
        <div class="card-header">
            {{ icon('bug', 'icon') }}
            Rischio Mosca Olearia
        </div>
        {% if pestPrediction %}
        {% set pr = pestPrediction.result %}
        {% set riskClass = pr.risk_score < 0.3 ? 'risk-low' : (pr.risk_score < 0.5 ? 'risk-medium' : (pr.risk_score < 0.7 ? 'risk-high' : 'risk-very-high')) %}
        <div class="card-body">
            <div class="risk-badge {{ riskClass }}">
                <span class="risk-score-value">{{ (pr.risk_score * 100)|number_format(0) }}%</span>
                Rischio {{ pr.risk_level|capitalize }}
            </div>
            <div class="info-list mt-md">
                <div class="info-row">
                    <span class="label">Generazione</span>
                    <span class="value">Gen. {{ pr.generazione_n ?? '—' }}</span>
                </div>
                <div class="info-row">
                    <span class="label">Fase biologica</span>
                    <span class="value">{{ pr.fase_corrente is defined ? pr.fase_corrente|capitalize : '—' }}</span>
                </div>
                {% if pr.finestra_trattamento is defined %}
                <div class="info-row">
                    <span class="label">Finestra trattamento</span>
                    <span class="value">{{ pr.finestra_trattamento.inizio }} / {{ pr.finestra_trattamento.fine }}</span>
                </div>
                {% endif %}
                {% if pr.economic_impact is defined %}
                <div class="info-row">
                    <span class="label">Perdita stimata</span>
                    <span class="value">{{ pr.economic_impact.perdita_stimata_eur_ha|number_format(0) }} €/ha</span>
                </div>
                {% endif %}
            </div>
            {% if pr.recommendations is defined and pr.recommendations|length > 0 %}
            <ul class="recommendation-list">
                {% for rec in pr.recommendations %}
                <li>{{ rec }}</li>
                {% endfor %}
            </ul>
            {% endif %}
            {% if pestPrediction.explanationText %}
            <div class="explanation-box">{{ pestPrediction.explanationText }}</div>
            {% endif %}
            <p class="prediction-meta">{{ pestPrediction.createdAt|date('d/m/Y H:i') }}</p>
        </div>
        {% else %}
        <div class="card-body">
            <p class="prediction-empty">Nessuna analisi — clicca Aggiorna per calcolarla.</p>
        </div>
        {% endif %}
        <div class="card-footer">
            <form method="post" action="{{ path('monitoring_predict_pest') }}">
                <button type="submit" class="update-btn">Aggiorna</button>
            </form>
        </div>
    </div>

    {# ── STRESS IDRICO ────────────────────────────────────── #}
    <div class="card">
        <div class="card-header">
            {{ icon('droplets', 'icon') }}
            Stress Idrico — Bilancio FAO-56
        </div>
        {% if waterPrediction %}
        {% set wr = waterPrediction.result %}
        {% set stressPct = (wr.stress_index * 100)|round %}
        {% set stressClass = wr.stress_index == 0 ? 'stress-fill-none' : (wr.stress_index < 0.25 ? 'stress-fill-low' : (wr.stress_index < 0.5 ? 'stress-fill-medium' : (wr.stress_index < 0.75 ? 'stress-fill-high' : 'stress-fill-severe'))) %}
        <div class="card-body">
            <div class="stress-bar-wrap">
                <div class="stress-bar-label">
                    <span>Indice stress</span>
                    <span><strong>{{ stressPct }}%</strong></span>
                </div>
                <div class="stress-bar">
                    <div class="stress-bar-fill {{ stressClass }}" style="--bar-w: {{ stressPct > 100 ? 100 : stressPct }}%"></div>
                </div>
            </div>
            <div class="stress-bar-wrap">
                <div class="stress-bar-label">
                    <span>Riserva idrica</span>
                    <span><strong>{{ wr.reserve_pct|number_format(0) }}%</strong></span>
                </div>
                <div class="stress-bar">
                    <div class="reserve-bar-fill" style="--bar-w: {{ wr.reserve_pct > 100 ? 100 : wr.reserve_pct }}%"></div>
                </div>
            </div>
            <div class="{{ wr.irrigation_needed ? 'irrigation-alert irrigation-needed' : 'irrigation-alert irrigation-ok' }}">
                {% if wr.irrigation_needed %}
                    Irrigazione necessaria — {{ wr.volume_mc_per_ha|number_format(1) }} m³/ha
                {% else %}
                    Nessuna irrigazione necessaria
                {% endif %}
            </div>
            {% if wr.economic_impact is defined and wr.economic_impact.costo_acqua_eur > 0 %}
            <div class="info-list mt-sm">
                <div class="info-row">
                    <span class="label">Costo irrigazione</span>
                    <span class="value">{{ wr.economic_impact.costo_acqua_eur|number_format(0) }} €</span>
                </div>
            </div>
            {% endif %}
            {% if waterPrediction.explanationText %}
            <div class="explanation-box">{{ waterPrediction.explanationText }}</div>
            {% endif %}
            <p class="prediction-meta">{{ waterPrediction.createdAt|date('d/m/Y H:i') }}</p>
        </div>
        {% else %}
        <div class="card-body">
            <p class="prediction-empty">Nessun bilancio — clicca Aggiorna per calcolarlo.</p>
        </div>
        {% endif %}
        <div class="card-footer">
            <form method="post" action="{{ path('monitoring_predict_water') }}">
                <button type="submit" class="update-btn">Aggiorna</button>
            </form>
        </div>
    </div>

</div>
{% endif %}
{% endblock %}