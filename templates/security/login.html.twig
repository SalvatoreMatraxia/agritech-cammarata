{% extends 'base.html.twig' %}

{% block title %}Accedi — Agritech Cammarata{% endblock %}

{% block main %}
<main class="login-main">
    <div class="login-card">
        <div class="login-header">
            <span class="logo">{{ icon('leaf', 'icon icon-login') }}</span>
            <h1>Agritech Cammarata</h1>
            <p>DSS per olivicoltura biologica mediterranea</p>
        </div>
        <div class="login-body">
            {% if error %}
            <div class="error-box">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <form method="post">
                <div class="field">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email"
                           value="{{ last_username }}"
                           autocomplete="email" autofocus required>
                </div>
                <div class="field">
                    <label for="password">Password</label>
                    <input type="password" id="password" name="password"
                           autocomplete="current-password" required>
                </div>
                <div class="remember-row">
                    <input type="checkbox" id="remember" name="_remember_me">
                    <label for="remember">Ricordami per 7 giorni</label>
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <button class="btn-login" type="submit">Accedi</button>
            </form>
        </div>
        <div class="login-footer">
            Agritech Cammarata &copy; {{ 'now'|date('Y') }} — Olivicoltura biologica
        </div>
    </div>
</main>
{% endblock %}